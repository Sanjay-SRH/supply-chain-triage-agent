# Copy to .env and edit. Never commit .env.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_SSL=false
GRAPH_NAME=triage
# Crawl limits for the npm dependency crawl
MAX_DEPTH=3
MAX_VERSIONS=900

# Agent (Day 2). Get a key at console.anthropic.com (separate from a Claude chat subscription)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
TRIAGE_TENANT=acme

# Web API (Day 3)
# DEMO_MODE=true      # force the scripted (no-LLM) agent even if a key is set
# TENANTS=acme,globex # tenants the UI/API accept
# RATE_LIMIT=30       # chat requests per client per window (protects your API credits on a public deploy)
# RATE_WINDOW=600     # seconds
# CORS_ORIGINS=       # only needed if the UI is served from a different origin
